{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "prefix": "ui",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui", "platform:browser"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/ui/jest.config.cts",
        "tsConfig": "libs/shared/ui/tsconfig.spec.json"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/*/src/styles.css",
        "{workspaceRoot}/apps/*/src/index.html"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "command": "tsc --noEmit -p {projectRoot}/tsconfig.lib.json"
    }
  }
}
