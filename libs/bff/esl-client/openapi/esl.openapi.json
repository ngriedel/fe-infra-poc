          "fieldB",
          "fieldC",
          "fieldD",
          "fieldE",
          "fieldF",
          "fieldG",
          "fieldH",
          "fieldI",
          "fieldJ",
          "fieldK",
          "fieldL",
          "fieldM",
          "fieldN",
          "fieldO",
          "fieldP",
          "fieldQ",
          "fieldR",
          "fieldS",
          "fieldT",
          "id",
          "monthlyPremium",
          "product",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "product": { "type": "string" },
          "status": { "type": "string" },
          "monthlyPremium": { "type": "integer", "format": "int32" },
          "fieldA": { "type": "string" },
          "fieldB": { "type": "string" },
          "fieldC": { "type": "integer", "format": "int32" },
          "fieldD": { "type": "integer", "format": "int32" },
          "fieldE": { "type": "boolean" },
          "fieldF": { "type": "string" },
