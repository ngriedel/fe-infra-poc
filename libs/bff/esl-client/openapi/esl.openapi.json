          "fieldM": { "type": "integer", "format": "int32" },
          "fieldN": { "type": "string" },
          "fieldO": { "type": "integer", "format": "int32" },
          "fieldP": { "type": "string" },
          "fieldQ": { "type": "boolean" },
          "fieldR": { "type": "integer", "format": "int32" },
          "fieldS": { "type": "string" },
          "fieldT": { "type": "string" }
        }
      },
      "Identity": {
        "required": ["email", "roles", "userId"],
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "email": { "type": "string" },
