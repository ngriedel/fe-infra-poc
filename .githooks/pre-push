#!/bin/sh
#
# Pre-push gate.
#
# This runs the same targets as .github/workflows/ci.yml, deliberately. CI is the
# gate that counts — it cannot be skipped with --no-verify and it runs on a fresh
# clone — but a failure there costs a round trip, so the same checks run here
# first. If you change the target list, change it in both places or they will
# drift into disagreeing about what "green" means.
#
# `build` IS part of the gate, and it has to be: it is the only step that
# type-checks Angular templates. The four apps have no `typecheck` target, so
# `run-many -t typecheck` skips them silently — and even with one, plain `tsc`
# treats an inline `template:` as an opaque string and never looks inside. Only
# the Angular compiler reads templates, and only during a build.
#
# Demonstrated: `{{ auth.user().totallyNotAReadProperty }}` in a real template
# passes lint + test + typecheck across all 19 projects, and fails the build with
# TS2339. Templates are where most of an Angular app's logic lives; without this
# step that half of the codebase has no gate in front of it.
#
# It is the long pole, but Nx caches per project, so an unchanged tree replays
# instantly and you only pay for what you actually touched.
#
# Installed by the `prepare` script in package.json, which points
# core.hooksPath at this directory. Bypass a single push with `--no-verify`.

set -e

NX="./node_modules/.bin/nx"
if [ ! -x "$NX" ]; then
  echo "pre-push: $NX not found — skipping (run an install first)."
  exit 0
fi

echo "pre-push: running the gate (lint, test, typecheck, build, format) …"

if ! "$NX" run-many -t lint test typecheck build; then
  echo ""
  echo "pre-push: FAILED — lint/test/typecheck/build did not pass."
  echo "          Fix the failures, or push with --no-verify to override."
  exit 1
fi

if ! "$NX" format:check; then
  echo ""
  echo "pre-push: FAILED — formatting is not clean."
  echo "          Run 'nx format:write', or push with --no-verify to override."
  exit 1
fi

echo "pre-push: gate green."
