# Copy to .env and adjust. SESSION_SECRET below is for dev only.
NODE_ENV=development
HOST=0.0.0.0
PORT=3003

# Generate a real one with: openssl rand -hex 32
SESSION_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

FRONTEND_ORIGIN=http://localhost:4202
LOG_PRETTY=true

# stub | azure
# When set to azure, the four AZURE_* vars below become required.
OIDC_MODE=stub

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=http://localhost:3003/api/auth/callback

POST_LOGIN_DEFAULT=/
