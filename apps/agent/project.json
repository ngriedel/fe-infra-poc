{
  "name": "agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "agent",
  "sourceRoot": "apps/agent/src",
  "tags": ["scope:agent", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/agent",
        "browser": "apps/agent/src/main.ts",
        "tsConfig": "apps/agent/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/agent/public"
          }
        ],
        "styles": ["apps/agent/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4201,
        "proxyConfig": "apps/agent/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "agent:build:production"
        },
        "development": {
          "buildTarget": "agent:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/agent/jest.config.cts",
        "tsConfig": "apps/agent/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "agent:build",
        "port": 4201,
        "staticFilePath": "dist/apps/agent/browser",
        "spa": true
      }
    }
  }
}
