# Copy to .env and adjust. SESSION_SECRET below is for dev only.
NODE_ENV=development
HOST=0.0.0.0
PORT=3002

# Generate a real one with: openssl rand -hex 32
SESSION_SECRET=a772320a956a13e30dde12c563a98d47e33feeaa76e18479498b641d4514d1af

FRONTEND_ORIGIN=http://localhost:4201
LOG_PRETTY=true

# stub | azure
# When set to azure, the four AZURE_* vars below become required.
OIDC_MODE=stub

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# NOTE: must match the browser origin (the Angular dev origin, proxied to this BFF),
# NOT the BFF's own port — otherwise the state cookie won't reach the callback.
# AZURE_REDIRECT_URI=http://localhost:4201/api/auth/callback

POST_LOGIN_DEFAULT=/
