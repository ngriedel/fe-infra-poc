# Copy to .env and adjust. SESSION_SECRET below is for dev only.
NODE_ENV=development
HOST=0.0.0.0
PORT=3004

# Generate a real one with: openssl rand -hex 32
SESSION_SECRET=cd017e22b69c634f520785f071fecfa621c9288591958f8cbd240d7ab6ffd8bb

FRONTEND_ORIGIN=http://localhost:4203
LOG_PRETTY=true

# stub | azure
# When set to azure, the four AZURE_* vars below become required.
OIDC_MODE=stub

# Broker is tier 2: email + password managed in Entra External ID (CIAM).
# Set AZURE_AUTHORITY to the CIAM authority — without it the workforce
# authority (login.microsoftonline.com) is derived from AZURE_TENANT_ID.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_AUTHORITY=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
# NOTE: must match the browser origin (the Angular dev origin, proxied to this BFF),
# NOT the BFF's own port — otherwise the state cookie won't reach the callback.
# AZURE_REDIRECT_URI=http://localhost:4203/api/auth/callback

POST_LOGIN_DEFAULT=/

# Trust X-Forwarded-* when deriving req.ip. Governs rate-limit bucketing:
# behind a load balancer with this off, everyone shares the balancer's IP and
# one bucket. Turned on while directly reachable, clients can spoof
# X-Forwarded-For for a fresh bucket per request. Prefer a hop count or CIDR
# list over `true`. Values: false | true | <hops> | <csv of IPs/CIDRs>
TRUST_PROXY=false
