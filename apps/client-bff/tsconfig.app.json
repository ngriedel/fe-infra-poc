{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Specs are type-checked by `tsconfig.spec.json` (which pulls in jest types)
  // and must not be bundled into the app build.
  "exclude": ["src/**/*.spec.ts"]
}
