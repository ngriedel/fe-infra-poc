# Copy to .env and adjust. SESSION_SECRET below is for dev only.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Generate a real one with: openssl rand -hex 32
# Doubles as the pepper for hashing OTPs at rest.
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

FRONTEND_ORIGIN=http://localhost:4200
LOG_PRETTY=true

# OTP mail. Defaults point at the Mailpit container from docker-compose:
# SMTP on :1025, and you read the mail at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=AIC <no-reply@aic.local>

# Echo the OTP back in the API response so the login form auto-fills it.
# Left false so the normal path proves the real mail send. Never true in prod.
EXPOSE_DEV_OTP=false

# Trust X-Forwarded-* when deriving req.ip. Governs rate-limit bucketing:
# behind a load balancer with this off, everyone shares the balancer's IP and
# one bucket. Turned on while directly reachable, clients can spoof
# X-Forwarded-For for a fresh bucket per request. Prefer a hop count or CIDR
# list over `true`. Values: false | true | <hops> | <csv of IPs/CIDRs>
TRUST_PROXY=false
