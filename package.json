    "@nx/angular": "22.7.4",
    "@nx/devkit": "22.7.4",
    "@nx/eslint": "22.7.4",
    "@nx/eslint-plugin": "22.7.4",
    "@nx/jest": "22.7.4",
    "@nx/js": "22.7.4",
    "@nx/node": "22.7.4",
    "@nx/playwright": "22.7.4",
