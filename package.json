{
  "name": "aic",
  "version": "0.0.0",
  "private": true,
  "description": "AIC POC — Nx monorepo with client + agent Angular frontends and per-frontend Fastify BFFs.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "nx run-many -t serve --parallel=4",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "format": "nx format:write",
    "format:check": "nx format:check"
  },
  "devDependencies": {
    "@nx/angular": "22.7.4",
    "@nx/eslint": "22.7.4",
    "@nx/jest": "22.7.4",
    "@nx/js": "22.7.4",
    "@nx/node": "22.7.4",
    "@nx/playwright": "22.7.4",
    "@nx/workspace": "22.7.4",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "nx": "^22.7.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "nx",
      "esbuild",
      "@parcel/watcher",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
